############################################################
# Project Crystal
# Shared Services Networking
############################################################

############################################################
# AWS
############################################################

aws_profile = "shared-services"

aws_region = "ap-south-1"

############################################################
# VPC
############################################################

vpc_name = "crystal-shared-vpc"

vpc_cidr = "10.0.0.0/16"

############################################################
# PUBLIC SUBNETS
############################################################

public_subnets = {

  "crystal-public-subnet-a" = {

    cidr = "10.0.1.0/24"

    az = "ap-south-1a"

  }

  "crystal-public-subnet-b" = {

    cidr = "10.0.2.0/24"

    az = "ap-south-1b"

  }

}

############################################################
# PRIVATE SUBNETS
############################################################

private_subnets = {

  "crystal-private-subnet-a" = {

    cidr = "10.0.11.0/24"

    az = "ap-south-1a"

  }

  "crystal-private-subnet-b" = {

    cidr = "10.0.12.0/24"

    az = "ap-south-1b"

  }

}

############################################################
# TAGS
############################################################

common_tags = {

  Project = "Crystal"

  Environment = "SharedServices"

  ManagedBy = "Terraform"

}